# Firebase Configuration (Vite)
# Used for member registration, event RSVPs, and check-in. Get these values
# from Firebase Console > Project Settings > General > Your apps.
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Admin access
# Gates the hidden /admin/members page (src/components/AdminGuard.tsx).
# Leave unset to keep that page locked out entirely.
VITE_ADMIN_PASS=choose-a-passcode
